---
/* Original flat illustrations, drawn in SVG. One component, eight scenes. */
import type { Scene } from '../data/scenes';
import { sceneLabel } from '../data/scenes';
interface Props { scene: Scene; class?: string; compact?: boolean }
const { scene, class: cls = '', compact = false } = Astro.props;
const g = globalThis as unknown as { __sceneN?: number };
g.__sceneN = (g.__sceneN ?? 0) + 1;
const id = `sc${scene}${g.__sceneN}`;

// deterministic pseudo-random for repeated details
let seed = scene.length * 97;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);

const acacia = (x: number, y: number, s: number, fill: string) =>
  `<g transform="translate(${x} ${y}) scale(${s})" fill="${fill}">
    <path d="M-3 0 L-2 -38 L-14 -52 L-12 -54 L-1 -43 L1 -58 L3 -58 L3 -44 L15 -55 L17 -53 L4 -38 L3 0 Z"/>
    <ellipse cx="-16" cy="-56" rx="22" ry="7"/><ellipse cx="14" cy="-58" rx="26" ry="8"/><ellipse cx="0" cy="-63" rx="30" ry="8"/>
  </g>`;
const giraffe = (x: number, y: number, s: number, fill: string) =>
  `<g transform="translate(${x} ${y}) scale(${s})" fill="${fill}">
    <path d="M0 0 L2 -26 L-8 -28 L-10 0 L-12 0 L-11 -30 Q-12 -38 -4 -40 L14 -42 L30 -88 L34 -92 L42 -90 L44 -86 L38 -84 L20 -40 Q22 -34 18 -28 L20 0 L18 0 L14 -26 L4 -26 L2 0 Z"/>
    <path d="M34 -92 L33 -98 L35 -98 L36 -92 Z M38 -91 L38 -97 L40 -97 L40 -91 Z"/>
  </g>`;
const elephant = (x: number, y: number, s: number, fill: string) =>
  `<g transform="translate(${x} ${y}) scale(${s})" fill="${fill}">
    <path d="M0 0 L0 -14 Q-2 -30 14 -32 L34 -32 Q46 -32 48 -22 Q52 -16 50 -6 L52 4 L49 4 L46 -8 Q46 -14 44 -16 L44 0 L39 0 L39 -12 L22 -12 L22 0 L17 0 L17 -12 L6 -12 L5 0 Z"/>
    <path d="M40 -30 Q50 -34 50 -24 L46 -20 Z" opacity=".6"/>
  </g>`;
const palm = (x: number, y: number, s: number, fill: string, lean = 1) =>
  `<g transform="translate(${x} ${y}) scale(${s * lean} ${s})" fill="${fill}">
    <path d="M-2 0 Q4 -40 14 -78 L18 -77 Q9 -40 3 0 Z"/>
    <path d="M16 -78 Q-6 -84 -26 -70 Q-6 -78 16 -74 Z"/><path d="M16 -78 Q34 -92 56 -84 Q34 -86 17 -74 Z"/>
    <path d="M16 -78 Q6 -100 -10 -104 Q8 -96 15 -76 Z"/><path d="M16 -78 Q30 -66 40 -48 Q28 -64 15 -75 Z"/>
    <path d="M16 -78 Q-4 -70 -12 -52 Q2 -68 15 -75 Z"/><path d="M16 -78 Q28 -98 44 -102 Q28 -92 17 -76 Z"/>
  </g>`;
const reeds = (x0: number, x1: number, y: number, fill: string, n: number) =>
  Array.from({ length: n }, () => {
    const x = x0 + rnd() * (x1 - x0), h = 20 + rnd() * 30, b = (rnd() - 0.5) * 10;
    return `<path d="M${x} ${y} Q${x + b / 2} ${y - h / 2} ${x + b} ${y - h}" stroke="${fill}" stroke-width="2" fill="none"/><ellipse cx="${x + b}" cy="${y - h - 3}" rx="2.5" ry="5" fill="${fill}"/>`;
  }).join('');
const birds = (x: number, y: number, n: number, col: string) =>
  Array.from({ length: n }, (_, i) => {
    const bx = x + i * 22 + rnd() * 10, by = y + rnd() * 18;
    return `<path d="M${bx} ${by} q5 -5 10 0 q5 -5 10 0" stroke="${col}" stroke-width="2" fill="none" stroke-linecap="round"/>`;
  }).join('');

const svg: Record<Scene, string> = {
  savanna: `
    <defs><linearGradient id="${id}g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F4C98C"/><stop offset=".65" stop-color="#F0A866"/><stop offset="1" stop-color="#E58C4F"/></linearGradient></defs>
    <rect width="800" height="360" fill="url(#${id}g)"/>
    <circle cx="560" cy="200" r="70" fill="#FBE3B6"/>
    <path d="M0 230 Q120 200 240 222 T480 214 T800 226 V360 H0 Z" fill="#C98552"/>
    <path d="M0 262 Q160 240 330 258 T800 250 V360 H0 Z" fill="#A36A3C"/>
    <path d="M0 300 Q200 280 420 296 T800 290 V360 H0 Z" fill="#7C4F2A"/>
    ${acacia(150, 262, 1.3, '#4A2E18')}${acacia(640, 258, 1.7, '#3A2312')}${acacia(470, 250, .8, '#5C3A1F')}
    ${giraffe(300, 300, 1, '#3A2312')}${giraffe(360, 304, .8, '#3A2312')}
    ${birds(80, 70, 4, '#7C4F2A')}`,
  delta: `
    <defs><linearGradient id="${id}g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#CFE6E2"/><stop offset="1" stop-color="#F3E6C4"/></linearGradient>
    <linearGradient id="${id}w" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7FB7B5"/><stop offset="1" stop-color="#3F7F83"/></linearGradient></defs>
    <rect width="800" height="360" fill="url(#${id}g)"/>
    <circle cx="180" cy="110" r="44" fill="#FBF1D2"/>
    <path d="M0 200 Q200 186 400 196 T800 192 V360 H0 Z" fill="#9DB872"/>
    <rect y="214" width="800" height="146" fill="url(#${id}w)"/>
    <path d="M60 214 Q140 200 230 214 Z M520 214 Q620 196 720 214 Z" fill="#6E9A4E"/>
    ${palm(120, 214, .9, '#2F5A36')}${palm(600, 214, 1.1, '#2F5A36', -1)}${palm(660, 214, .7, '#3D6B43')}
    <g stroke="#E8F4F0" stroke-width="2" opacity=".6">${Array.from({ length: 9 }, (_, i) => `<line x1="${60 + i * 80}" y1="${250 + (i % 3) * 30}" x2="${110 + i * 80}" y2="${250 + (i % 3) * 30}"/>`).join('')}</g>
    ${reeds(0, 260, 330, '#3E6B3A', 22)}${reeds(560, 800, 336, '#3E6B3A', 22)}
    <g fill="#26302A"><path d="M330 292 L470 292 Q460 304 340 304 Z"/><path d="M402 292 L400 252 Q408 248 410 254 L408 292 Z"/><circle cx="406" cy="246" r="6"/><line x1="380" y1="230" x2="440" y2="320" stroke="#26302A" stroke-width="3"/></g>`,
  forest: `
    <defs><linearGradient id="${id}g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#DCE7DE"/><stop offset="1" stop-color="#B9CDBE"/></linearGradient></defs>
    <rect width="800" height="360" fill="url(#${id}g)"/>
    <path d="M120 220 L300 70 L330 66 L520 220 Z" fill="#8FA595"/>
    <path d="M430 220 L590 96 L612 94 L780 220 Z" fill="#9EB3A2"/>
    <path d="M300 70 L330 66 L346 82 L284 84 Z" fill="#7A8F80"/>
    <rect y="170" width="800" height="40" fill="#E8EFE8" opacity=".7"/>
    <path d="M0 230 Q60 196 120 222 Q170 190 230 220 Q290 186 350 218 Q410 190 470 220 Q540 186 600 220 Q660 194 720 222 Q760 204 800 216 V360 H0 Z" fill="#4F7A58"/>
    <rect y="236" width="800" height="18" fill="#E8EFE8" opacity=".45"/>
    <path d="M0 270 Q50 240 100 268 Q150 236 210 266 Q270 238 330 268 Q390 240 450 270 Q520 238 580 268 Q640 242 700 270 Q750 248 800 262 V360 H0 Z" fill="#2F5A3B"/>
    <path d="M0 320 Q80 296 160 318 Q240 292 320 318 Q400 296 480 320 Q560 294 640 318 Q720 298 800 314 V360 H0 Z" fill="#1E3F2A"/>
    ${birds(560, 60, 3, '#5C7364')}`,
  mountain: `
    <defs><linearGradient id="${id}g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#BFD7E6"/><stop offset="1" stop-color="#F2E3C6"/></linearGradient></defs>
    <rect width="800" height="360" fill="url(#${id}g)"/>
    <path d="M90 250 L320 104 Q400 84 480 104 L720 250 Z" fill="#7E8C9A"/>
    <path d="M320 104 Q400 84 480 104 L452 124 L428 112 L404 126 L380 112 L356 126 L340 116 Z" fill="#F7FAFC"/>
    <g fill="#FFFFFF" opacity=".85"><ellipse cx="200" cy="200" rx="120" ry="16"/><ellipse cx="560" cy="190" rx="150" ry="18"/><ellipse cx="400" cy="214" rx="180" ry="14"/></g>
    <path d="M0 262 Q200 244 400 258 T800 252 V360 H0 Z" fill="#C9A46A"/>
    <path d="M0 300 Q220 282 460 298 T800 292 V360 H0 Z" fill="#A9844C"/>
    ${acacia(110, 300, 1.1, '#4A3A22')}${acacia(700, 296, 1.4, '#4A3A22')}
    ${elephant(330, 318, 1, '#4E4A44')}${elephant(400, 320, .8, '#4E4A44')}${elephant(450, 322, .55, '#4E4A44')}`,
  beach: `
    <defs><linearGradient id="${id}g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#BFE6F0"/><stop offset="1" stop-color="#F6F1DE"/></linearGradient>
    <linearGradient id="${id}w" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2FA6B5"/><stop offset="1" stop-color="#7FD3D3"/></linearGradient></defs>
    <rect width="800" height="360" fill="url(#${id}g)"/>
    <circle cx="640" cy="90" r="40" fill="#FFF6D8"/>
    <rect y="190" width="800" height="110" fill="url(#${id}w)"/>
    <g stroke="#FFFFFF" stroke-width="2" opacity=".55">${Array.from({ length: 8 }, (_, i) => `<line x1="${40 + i * 95}" y1="${214 + (i % 3) * 22}" x2="${90 + i * 95}" y2="${214 + (i % 3) * 22}"/>`).join('')}</g>
    <path d="M0 292 Q200 270 420 288 T800 280 V360 H0 Z" fill="#F1E1B8"/>
    <path d="M0 330 Q240 316 480 330 T800 324 V360 H0 Z" fill="#E6CF9C"/>
    <g transform="translate(470 236)"><path d="M-40 0 L50 0 Q44 12 -30 12 Z" fill="#6B4A2E"/><path d="M4 0 L4 -70 L44 -6 Z" fill="#FBF4E4"/><path d="M4 -70 L-28 -10 L4 -6 Z" fill="#EFE3C6"/><line x1="4" y1="0" x2="4" y2="-74" stroke="#6B4A2E" stroke-width="2"/></g>
    ${palm(120, 300, 1.4, '#2E6B4E')}${palm(170, 304, 1, '#3F7D5D', -1)}`,
  falls: `
    <defs><linearGradient id="${id}g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#CFE3EA"/><stop offset="1" stop-color="#E7EFE6"/></linearGradient></defs>
    <rect width="800" height="360" fill="url(#${id}g)"/>
    <path d="M120 360 A300 300 0 0 1 680 360" fill="none" stroke="#F3B5A8" stroke-width="8" opacity=".55"/>
    <path d="M136 360 A284 284 0 0 1 664 360" fill="none" stroke="#F5DE9A" stroke-width="8" opacity=".55"/>
    <path d="M152 360 A268 268 0 0 1 648 360" fill="none" stroke="#A9D7B8" stroke-width="8" opacity=".55"/>
    <path d="M0 120 H800 V150 H0 Z" fill="#4E7A55"/>
    <rect y="148" width="800" height="12" fill="#6F8C7B"/>
    <g stroke="#FFFFFF" stroke-width="3" opacity=".9">${Array.from({ length: 70 }, (_, i) => `<line x1="${i * 11.5 + 4}" y1="158" x2="${i * 11.5 + 4 + (rnd() - .5) * 4}" y2="${250 + rnd() * 30}"/>`).join('')}</g>
    <rect y="156" width="800" height="110" fill="#DDEBEF" opacity=".35"/>
    <ellipse cx="400" cy="274" rx="460" ry="40" fill="#F4F8F8" opacity=".9"/>
    <path d="M0 290 Q120 260 200 300 L220 360 H0 Z" fill="#5B4A3C"/>
    <path d="M800 286 Q680 258 600 300 L580 360 H800 Z" fill="#5B4A3C"/>
    <path d="M220 360 Q400 320 580 360 Z" fill="#3E6E7A"/>
    ${birds(500, 50, 3, '#6F8C7B')}`,
  desert: `
    <defs><linearGradient id="${id}g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#A8CBE0"/><stop offset="1" stop-color="#E9DCC8"/></linearGradient></defs>
    <rect width="800" height="360" fill="url(#${id}g)"/>
    <path d="M-20 250 C60 210 130 150 180 122 C230 170 290 226 350 250 Z" fill="#D86A3A"/>
    <path d="M180 122 C196 180 222 228 246 250 L350 250 C290 226 230 170 180 122 Z" fill="#9C3F1E"/>
    <path d="M240 250 C330 200 420 120 470 82 C540 150 620 220 700 250 Z" fill="#E07A45"/>
    <path d="M470 82 C490 160 530 220 560 250 L700 250 C620 220 540 150 470 82 Z" fill="#A8471F"/>
    <path d="M600 250 C660 210 710 170 744 150 C790 190 830 230 870 250 Z" fill="#D86A3A"/>
    <path d="M744 150 C756 200 776 232 792 250 L870 250 C830 230 790 190 744 150 Z" fill="#9C3F1E"/>
    <path d="M0 250 H800 V360 H0 Z" fill="#EEE6D8"/>
    <g fill="none" stroke="#D9CDBA" stroke-width="1.5">${Array.from({ length: 14 }, (_, i) => `<path d="M${i * 60} ${270 + (i % 4) * 22} l24 10 l20 -6"/>`).join('')}</g>
    <g stroke="#2B1E16" stroke-width="5" fill="none" stroke-linecap="round">
      <path d="M220 330 L224 280 L206 256 M224 280 L246 262 M216 266 L200 250"/>
      <path d="M520 336 L516 290 L540 268 M516 290 L496 270 M532 276 L548 262 M500 274 L488 262"/>
      <path d="M360 322 L362 296 L376 284 M362 296 L350 286"/>
    </g>`,
  oasis: `
    <defs><linearGradient id="${id}g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F7D9A6"/><stop offset="1" stop-color="#F2EAD6"/></linearGradient></defs>
    <rect width="800" height="360" fill="url(#${id}g)"/>
    <circle cx="200" cy="120" r="46" fill="#FFF0CC"/>
    <path d="M380 240 L470 120 L560 240 Z" fill="#D9A766"/><path d="M470 120 L560 240 L500 240 Z" fill="#B9864A"/>
    <path d="M540 240 L610 150 L680 240 Z" fill="#D9A766"/><path d="M610 150 L680 240 L630 240 Z" fill="#B9864A"/>
    <path d="M300 240 L340 190 L380 240 Z" fill="#E0B47A"/>
    <path d="M0 236 Q200 220 400 236 T800 230 V360 H0 Z" fill="#E7C48C"/>
    <path d="M0 290 Q220 262 460 286 T800 278 V360 H0 Z" fill="#D7AE72"/>
    <ellipse cx="200" cy="312" rx="140" ry="16" fill="#5BA0A5" opacity=".8"/>
    ${palm(110, 312, 1.2, '#3E5B34')}${palm(170, 316, .9, '#4C6B3F', -1)}${palm(290, 314, 1, '#3E5B34')}
    ${birds(620, 70, 3, '#B9864A')}`,
};
---
<figure class={`scene ${compact ? 'compact' : ''} ${cls}`}>
  <svg viewBox="0 0 800 360" preserveAspectRatio="xMidYMid slice" role="img" aria-label={sceneLabel[scene]} set:html={svg[scene]} />
</figure>
<style>
  .scene{margin:0;border-radius:18px;overflow:hidden;aspect-ratio:800/360;max-width:100%;background:var(--line)}
  .scene.compact{aspect-ratio:800/260;border-radius:14px}
  .scene svg{display:block;width:100%;height:100%}
</style>
