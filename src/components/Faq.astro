---
export interface QA { q: string; a: string }
interface Props { items: QA[]; title?: string }
const { items, title = 'Frequently asked questions' } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
<section class="section faq" aria-labelledby="faq-h">
  <h2 class="h2" id="faq-h">{title}</h2>
  {items.map((i) => (
    <details>
      <summary>{i.q}</summary>
      <p>{i.a}</p>
    </details>
  ))}
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>
