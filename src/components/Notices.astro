---
import type { Country } from '../data/types';
import { advisoryText, formatDate } from '../lib/visa';
interface Props { country: Country }
const { country } = Astro.props;
const adv = advisoryText[country.advisory];
---
{adv && (
  <p class={`notice ${country.advisory === 'avoid' ? 'risk' : ''}`}>
    <span aria-hidden="true">⚠</span><span><b>Travel advice.</b>{" "}{adv}</span>
  </p>
)}
<p class="notice">
  <span aria-hidden="true">ⓘ</span>
  <span>
    <b>Entry rules change often.</b> We checked these on {country.checkedAt ? formatDate(country.checkedAt) : 'a recent date'} against the <a href="#sources">sources below</a>. Confirm with {country.portal ? <a href={country.portal} rel="noopener" target="_blank">the official portal</a> : 'the embassy'} before you book.
  </span>
</p>
