---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { countries } from '../../data/countries';
import { passports } from '../../data/passports';
import { REGIONS } from '../../data/regions';
import { DATA_CHECKED } from '../../data/sources';
import { rule, visaLabel, stampClass, countryPath, formatDate, passportName } from '../../lib/visa';

export function getStaticPaths() {
  return Object.keys(REGIONS).map((region) => ({ params: { region } }));
}
const { region } = Astro.params as { region: string };
const R = REGIONS[region];
const list = countries.filter((c) => c.region === R.name).sort((a, b) => a.name.localeCompare(b.name));
const show = ['lithuania', 'united-kingdom', 'united-states'].map((s) => passports.find((p) => p.slug === s)!);
const title = `${R.name} entry requirements by country`;
const description = `Visa rules, yellow fever requirements and arrival airports for the ${list.length} countries of ${R.name}: ${list.slice(0, 5).map((c) => c.name).join(', ')} and more.`;
---
<Base title={title} description={description}>
  <div class="wrap">
    <section class="page-head">
      <Crumbs items={[{ name: 'Countries', href: '/countries/' }, { name: R.name, href: `/regions/${region}/` }]} />
      <p class="eyebrow">{list.length} countries</p>
      <h1 class="h1">{R.name}</h1>
      <p class="lede">{R.intro}</p>
      <p class="page-meta"><span>Last checked {formatDate(DATA_CHECKED)}</span></p>
    </section>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Country</th>{show.map((p) => <th scope="col">{passportName(p)}</th>)}<th scope="col">Yellow fever</th><th scope="col">Airports</th></tr></thead>
        <tbody>
          {list.map((c) => (
            <tr>
              <td><a href={countryPath(c)}>{c.name}</a></td>
              {show.map((p) => { const r = rule(c, p); return <td data-label={passportName(p)}><span class={`pill ${stampClass[r.type]}`}>{visaLabel[r.type]}</span></td>; })}
              <td data-label="Yellow fever">{c.yellowFever === 'all' ? 'All travellers' : c.yellowFever === 'risk' ? 'From risk countries' : 'Not required'}</td>
              <td data-label="Airports" class="mono">{c.airports.map((a) => a.code).join(' · ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="color:var(--muted);font-size:14px;margin-top:12px">Lithuanian rules shown as the EU example. Rules for other EU passports are on each country page.</p>
    <section class="section">
      <h2 class="h2">Other regions</h2>
      <ul class="chips">{Object.entries(REGIONS).filter(([k]) => k !== region).map(([k, v]) => <li><a href={`/regions/${k}/`}>{v.name}</a></li>)}</ul>
    </section>
  </div>
</Base>
