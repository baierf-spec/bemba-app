---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist." noindex>
  <div class="wrap narrow">
    <section class="page-head" style="padding-block:60px">
      <p class="eyebrow">404</p>
      <h1 class="h1">No entry stamp for this page.</h1>
      <p class="lede">The address may be mistyped, or the page has moved.</p>
      <p style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href="/countries/">Browse all countries</a><a class="btn ghost" href="/">Home</a></p>
    </section>
  </div>
</Base>
