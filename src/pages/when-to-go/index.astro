---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Scene from '../../components/Scene.astro';
import MonthStrip from '../../components/MonthStrip.astro';
import { destinations, MONTHS, monthSlug } from '../../data/seasons';
import { countryBySlug } from '../../data/countries';
import { countryPath } from '../../lib/visa';
---
<Base title="When to go to Africa: month by month" description="The best time to visit Africa's main safari, beach and desert destinations, month by month, with what happens when.">
  <div class="wrap">
    <section class="page-head">
      <Crumbs items={[{ name: 'When to go', href: '/when-to-go/' }]} />
      <h1 class="h1">When to go, month by month.</h1>
      <p class="lede">Pick a month to see where is at its best, or scan the calendar for each destination.</p>
    </section>
    <Scene scene="delta" compact />
    <ul class="months">{MONTHS.map((m, i) => <li><a href={`/when-to-go/${monthSlug(i)}/`}><b>{m}</b><span>{destinations.filter((d) => d.months[i] === 2).length} best picks</span></a></li>)}</ul>
    <section class="section">
      <h2 class="h2">Calendar by destination</h2>
      <div class="legend-m"><span class="k k2"></span>Best <span class="k k1"></span>Good <span class="k k0"></span>Avoid</div>
      <ul class="cal">{destinations.map((d) => <li><a href={countryPath(countryBySlug.get(d.country)!)}>{d.name}</a><MonthStrip d={d} /></li>)}</ul>
    </section>
  </div>
  <style>
    .months{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;list-style:none;margin:24px 0 0;padding:0}
    .months a{display:grid;gap:2px;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 14px;text-decoration:none}
    .months a:hover{border-color:var(--accent)}
    .months b{font-family:var(--display);font-size:18px}
    .months span{font-size:13px;color:var(--muted)}
    .cal{list-style:none;margin:0;padding:0;display:grid;gap:8px}
    .cal li{display:grid;grid-template-columns:240px 1fr;gap:16px;align-items:center}
    .cal li>a{font-weight:500;text-decoration:none;min-width:0}
    .legend-m{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);margin-bottom:14px}
    .k{width:14px;height:14px;border-radius:4px;display:inline-block}
    .k2{background:var(--accent)}.k1{background:var(--accent-soft)}.k0{box-shadow:inset 0 0 0 1px var(--line)}
    @media (max-width:640px){.cal li{grid-template-columns:1fr;gap:6px}}
  </style>
</Base>
