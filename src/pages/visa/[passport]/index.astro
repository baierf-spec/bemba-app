---
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import { countries } from '../../../data/countries';
import { passports } from '../../../data/passports';
import type { Passport } from '../../../data/passports';
import type { VisaType } from '../../../data/types';
import { rule, visaLabel, stampClass, visaPath, formatDate, listPath } from '../../../lib/visa';
import { DATA_CHECKED } from '../../../data/sources';

export function getStaticPaths() {
  return passports.map((p) => ({ params: { passport: p.slug }, props: { p } }));
}
interface Props { p: Passport }
const { p } = Astro.props;
const name = p.country.replace(/^the /, '').replace(/^./, (s) => s.toUpperCase());

const counts = countries.reduce((acc, c) => { const t = rule(c, p).type; acc[t] = (acc[t] ?? 0) + 1; return acc; }, {} as Partial<Record<VisaType, number>>);
const free = counts.free ?? 0;
const online = (counts.eta ?? 0) + (counts.evisa ?? 0) + (counts.voa ?? 0);
const embassy = counts.embassy ?? 0;
const none = counts.none ?? 0;

const title = `Africa visa requirements for ${p.demonym} citizens`;
const description = `Which African countries ${p.demonym} passport holders can visit visa-free, with an eVisa or visa on arrival, and where an embassy visa is needed. All 54 countries.`;
const sorted = [...countries].sort((a, b) => a.name.localeCompare(b.name));
---
<Base title={title} description={description}>
  <div class="wrap">
    <section class="page-head">
      <Crumbs items={[{ name: 'Visa by passport', href: '/visa/' }, { name, href: `/visa/${p.slug}/` }]} />
      <p class="eyebrow">{p.flag} passport · 54 countries</p>
      <h1 class="h1">{title}</h1>
      <p class="lede">With a passport from {p.country}, you can enter {free} African countries without a visa, {online} with an online visa or visa on arrival, and {embassy} with an embassy visa.{none > 0 && ` In ${none} countries, visas for this passport are currently suspended.`}</p>
    </section>

    <dl class="fact-grid" style="margin-bottom:32px">
      <div class="fact"><dt><a href={listPath('visa-free', p)}>Visa-free →</a></dt><dd class="h2" style="margin:0;color:var(--accent)">{free}</dd></div>
      <div class="fact"><dt><a href={listPath('evisa', p)}>eVisa</a> / <a href={listPath('visa-on-arrival', p)}>on arrival →</a></dt><dd class="h2" style="margin:0;color:var(--gold)">{online}</dd></div>
      <div class="fact"><dt>Embassy visa</dt><dd class="h2" style="margin:0;color:var(--stamp)">{embassy}</dd></div>
      {none > 0 && <div class="fact"><dt>Suspended</dt><dd class="h2" style="margin:0;color:var(--stamp)">{none}</dd></div>}
    </dl>

    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Country</th><th scope="col">Entry</th><th scope="col">Fee</th><th scope="col">Stay</th></tr></thead>
        <tbody>
          {sorted.map((c) => { const r = rule(c, p); return (
            <tr>
              <td><a href={visaPath(p, c)}>{c.name}</a></td>
              <td data-label="Entry"><span class={`pill ${stampClass[r.type]}`}>{visaLabel[r.type]}</span></td>
              <td data-label="Fee" class="mono">{r.fee ?? (r.type === 'free' ? '—' : 'See portal')}</td>
              <td data-label="Stay">{r.stay ?? '—'}</td>
            </tr>
          ); })}
        </tbody>
      </table>
    </div>
    <p style="margin-top:18px"><a href={p.advice.url} rel="noopener" target="_blank">Travel advice for {p.demonym} citizens: {p.advice.name} →</a></p>
    <p class="eyebrow" style="margin-top:14px;text-transform:none;letter-spacing:0">Last checked {formatDate(DATA_CHECKED)}. Each country page lists its sources. Confirm on the official portal before you book.</p>
  </div>
</Base>
