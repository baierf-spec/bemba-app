---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { passports } from '../../data/passports';
import { listPath, passportName } from '../../lib/visa';
const guides = [
  { href: '/when-to-go/', t: 'When to go, month by month', d: 'Where is at its best in each month of the year.' },
  { href: '/costs/', t: 'Safari costs', d: 'Official park fees, gorilla permits and visas by country.' },
  { href: '/compare/', t: 'Compare destinations', d: 'Kenya or Tanzania, Rwanda or Uganda, and more.' },
  { href: '/guides/rule-changes/', t: 'Rule changes 2025–2026', d: 'Malawi, Namibia, US suspensions and new fees.' },
  { href: '/health/yellow-fever/', t: 'Yellow fever certificates', d: 'Which countries ask every traveller for the yellow card.' },
  { href: '/health/malaria/', t: 'Malaria risk by country', d: 'Plan your travel clinic visit.' },
  { href: '/guides/east-africa-tourist-visa/', t: 'East Africa Tourist Visa', d: 'Kenya, Uganda and Rwanda on one US$100 visa.' },
  { href: '/guides/kaza-univisa/', t: 'KAZA UNIVISA', d: 'Zambia and Zimbabwe on one visa at Victoria Falls.' },
  { href: '/guides/official-visa-portals/', t: 'Official visa portals', d: 'Pay the government fee, not an agency mark-up.' },
];
const regions = ['north-africa', 'west-africa', 'central-africa', 'east-africa', 'southern-africa'];
---
<Base title="Africa travel guides" description="Guides to African entry rules: recent visa changes, yellow fever and malaria, multi-country visas and official eVisa portals.">
  <div class="wrap">
    <section class="page-head">
      <Crumbs items={[{ name: 'Guides', href: '/guides/' }]} />
      <h1 class="h1">Guides.</h1>
      <p class="lede">The rules that apply across borders, and the questions travellers ask before booking.</p>
    </section>
    <ul class="cards">{guides.map((g) => <li><a href={g.href}><b>{g.t}</b><span>{g.d}</span></a></li>)}</ul>
    <section class="section" style="margin-top:32px">
      <h2 class="h2">By region</h2>
      <ul class="chips">{regions.map((r) => <li><a href={`/regions/${r}/`}>{r.replace('-', ' ').replace(/^./, (s) => s.toUpperCase()).replace(/ africa$/, ' Africa')}</a></li>)}</ul>
    </section>
    <section class="section">
      <h2 class="h2">Visa-free countries by passport</h2>
      <ul class="chips">{passports.map((p) => <li><a href={listPath('visa-free', p)}>{passportName(p)}</a></li>)}</ul>
    </section>
  </div>
</Base>
