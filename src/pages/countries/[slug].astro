---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Faq from '../../components/Faq.astro';
import Notices from '../../components/Notices.astro';
import Partners from '../../components/Partners.astro';
import SafariCta from '../../components/SafariCta.astro';
import Sources from '../../components/Sources.astro';
import MonthStrip from '../../components/MonthStrip.astro';
import { destinations } from '../../data/seasons';
import { costBySlug } from '../../data/costs';
import { comparisons } from '../../data/comparisons';
import { countries } from '../../data/countries';
import { passports } from '../../data/passports';
import type { Country } from '../../data/types';
import { visaLabel, stampClass, yellowFeverText, malariaText, relatedCountries, visaPath, countryPath, rule, sourcesFor, groupedRules, passportName, formatDate } from '../../lib/visa';

export function getStaticPaths() {
  return countries.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
interface Props { c: Country }
const { c } = Astro.props;

const label = (s: string) => s.replace(/^the /, '').replace(/^./, (x) => x.toUpperCase());
const eu = c.visa.EU;
const title = `${c.name} entry requirements: visa, vaccines and arrival`;
const description = `${c.name} visa rules for ${passports.length} passports, yellow fever and malaria advice, airports (${c.airports.map((a) => a.code).join(', ')}), currency and the best time to visit.`;
const faq = [
  { q: `Do EU citizens need a visa for ${c.name}?`, a: eu.type === 'free' ? `No. EU passport holders can visit ${c.name} visa-free${eu.stay ? ` (${eu.stay.toLowerCase()})` : ''}.` : eu.type === 'eta' ? `No visa, but an online travel authorisation is required before you fly.` : eu.type === 'none' ? 'Visas are currently suspended.' : `Yes. Most EU passport holders need a visa (${visaLabel[eu.type].toLowerCase()})${eu.fee ? `; the fee is ${eu.fee}` : ''}.` },
  { q: `Is a yellow fever vaccination required for ${c.name}?`, a: yellowFeverText[c.yellowFever] },
  { q: `Is there malaria in ${c.name}?`, a: malariaText[c.malaria] },
  { q: `What is the best time to visit ${c.name}?`, a: `${c.bestTime} is generally the best time to visit.` },
  { q: `What currency is used in ${c.name}?`, a: `The currency is the ${c.currency.name} (${c.currency.code}). Cards work in cities and larger hotels; carry some cash for markets and rural areas.` },
];
const ld = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description,
  about: { '@type': 'Country', name: c.name },
  dateModified: c.checkedAt,
  publisher: { '@type': 'Organization', name: 'Bemba', url: 'https://bemba.com', logo: { '@type': 'ImageObject', url: 'https://bemba.com/og.png' } },
  author: { '@type': 'Organization', name: 'Bemba', url: 'https://bemba.com/about/' },
  image: 'https://bemba.com/og.png',
  inLanguage: 'en',
  mainEntityOfPage: new URL(Astro.url.pathname, 'https://bemba.com').href,
};
const nearby = relatedCountries(c, 8);
---
<Base title={title} description={description} jsonLd={[ld]} ogType="article">
  <div class="wrap">
    <section class="page-head">
      <Crumbs items={[{ name: 'Countries', href: '/countries/' }, { name: c.name, href: countryPath(c) }]} />
      <p class="eyebrow">{c.region} · {c.iso2} · {c.airports.map((a) => a.code).join(' · ')}</p>
      <h1 class="h1">{c.name} entry requirements</h1>
      <p class="lede">What you need to enter {c.name}: visa rules by passport, vaccines, arrival airports and practical details for your trip.</p>
      <p class="page-meta"><span>Last checked {formatDate(c.checkedAt!)}</span><span><a href={`/regions/${c.region.toLowerCase().replace(/\s/g, '-')}/`}>{c.region}</a></span></p>
    </section>

    <div class="article">
      <div>
        <Notices country={c} />

        <section aria-labelledby="visa-h">
          <h2 class="h2" id="visa-h">Visa rules by passport</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th scope="col">Passports</th><th scope="col">Entry</th><th scope="col">Fee</th><th scope="col">Stay</th></tr></thead>
              <tbody>
                {groupedRules(c).map(({ rule: r, passports: ps }) => (
                  <tr>
                    <td>{ps.length === passports.length ? <span>All {ps.length} passports we cover</span> : ps.map((p, i) => <>{i > 0 && ', '}<a href={visaPath(p, c)}>{passportName(p)}</a></>)}</td>
                    <td data-label="Entry"><span class={`pill ${stampClass[r.type]}`}>{visaLabel[r.type]}</span></td>
                    <td data-label="Fee" class="mono">{r.fee ?? (r.type === 'free' ? '—' : 'See portal')}</td>
                    <td data-label="Stay">{r.stay ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {eu.note && <p style="color:var(--muted);margin-top:12px"><b>Most EU passports:</b>{" "}{eu.note}</p>}
          {c.visa.US.type !== eu.type && c.visa.US.note && <p style="color:var(--muted);margin-top:8px"><b>US passports:</b>{" "}{c.visa.US.note}</p>}
          <p class="eyebrow" style="margin:20px 0 10px">Detailed guide for your passport</p>
          <ul class="chips">{passports.map((p) => <li><a href={visaPath(p, c)}>{p.demonym}</a></li>)}</ul>
        </section>

        <section class="section prose" aria-labelledby="health-h" style="margin-top:28px">
          <h2 class="h2" id="health-h">Health and vaccines</h2>
          <p><b>Yellow fever.</b> {yellowFeverText[c.yellowFever]}</p>
          <p><b>Malaria.</b> {malariaText[c.malaria]}</p>
          <p>Routine vaccines should be up to date. Travel clinics commonly also discuss hepatitis A, typhoid and, for longer rural stays, rabies. Book 6 to 8 weeks before departure.</p>
        </section>

        <section class="section" aria-labelledby="practical-h">
          <h2 class="h2" id="practical-h">Practical details</h2>
          <dl class="fact-grid">
            <div class="fact"><dt>Capital</dt><dd>{c.capital}</dd></div>
            <div class="fact"><dt>Currency</dt><dd>{c.currency.name} <span class="mono">({c.currency.code})</span></dd></div>
            <div class="fact"><dt>Languages</dt><dd>{c.languages.join(', ')}</dd></div>
            <div class="fact"><dt>Plug types</dt><dd>{c.plugs.join(', ')}</dd></div>
            <div class="fact"><dt>Best time</dt><dd>{c.bestTime}</dd></div>
            <div class="fact"><dt>Main airports</dt><dd>{c.airports.map((a) => `${a.city} (${a.code})`).join(', ')}</dd></div>
          </dl>
        </section>

        {(() => { const ds = destinations.filter((d) => d.country === c.slug); const cost = costBySlug.get(c.slug); const cmps = comparisons.filter((x) => x.a.country === c.slug || x.b.country === c.slug); return (ds.length || cost || cmps.length) ? (
          <section class="section" aria-labelledby="plan-h">
            <h2 class="h2" id="plan-h">Plan your trip</h2>
            {ds.map((d) => <div style="margin-bottom:14px"><p style="margin:0 0 6px;font-weight:600">{d.name} <span style="font-weight:400;color:var(--muted)">· best months</span></p><MonthStrip d={d} /></div>)}
            <ul class="chips" style="margin-top:12px">
              {cost && <li><a href={`/costs/${c.slug}/`}>{c.name} park fees and costs</a></li>}
              {cmps.map((x) => <li><a href={`/compare/${x.slug}/`}>{x.title}</a></li>)}
              <li><a href="/when-to-go/">When to go, month by month</a></li>
            </ul>
          </section>) : null; })()}

        <section class="section prose" aria-labelledby="see-h">
          <h2 class="h2" id="see-h">Highlights of {c.name}</h2>
          <ul>{c.highlights.map((h) => <li>{h}</li>)}</ul>
        </section>

        <Faq items={faq} />

        <Sources items={sourcesFor(c)} />

        <section class="section" aria-labelledby="near-h">
          <h2 class="h2" id="near-h">More in {c.region}</h2>
          <ul class="chips">{nearby.map((n) => <li><a href={countryPath(n)}>{n.name}</a></li>)}</ul>
        </section>
      </div>
      <aside class="aside" aria-label="Plan your trip">
        {c.safari && <SafariCta country={c.name} slug={c.slug} />}
        <Partners country={c.name} />
      </aside>
    </div>
  </div>
</Base>
