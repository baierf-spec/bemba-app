---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Faq from '../../components/Faq.astro';
import { countries } from '../../data/countries';
import { DATA_CHECKED, globalSources } from '../../data/sources';
import { countryPath, formatDate } from '../../lib/visa';
const by = (k: string) => countries.filter((c) => c.yellowFever === k).sort((a, b) => a.name.localeCompare(b.name));
const all = by('all'), risk = by('risk'), no = by('no');
const title = 'Yellow fever certificate requirements in Africa';
const description = `${all.length} African countries require a yellow fever certificate from every traveller; ${risk.length} require it only if you arrive from a risk country. Full list, checked ${formatDate(DATA_CHECKED)}.`;
const faq = [
  { q: 'Which African countries require a yellow fever certificate from all travellers?', a: `${all.map((c) => c.name).join(', ')}.` },
  { q: 'When does the yellow fever vaccine become valid?', a: 'The certificate is valid from 10 days after vaccination and, under WHO rules, for the rest of your life. Get vaccinated at least 10 days before you arrive.' },
  { q: 'Do I need the certificate if I fly direct from Europe?', a: `For the ${risk.length} countries in the "risk" group, no, unless you arrive from or transit through a country with yellow fever risk. Itineraries that combine several African countries often trigger the requirement.` },
  { q: 'Where do I get vaccinated?', a: 'Only at an authorised yellow fever vaccination centre, which issues the International Certificate of Vaccination (the yellow card). Ask your travel clinic or local health authority for the nearest one.' },
];
---
<Base title={title} description={description}>
  <div class="wrap narrow">
    <section class="page-head">
      <Crumbs items={[{ name: 'Guides', href: '/guides/' }, { name: 'Yellow fever', href: '/health/yellow-fever/' }]} />
      <p class="eyebrow">Health · 54 countries</p>
      <h1 class="h1">Yellow fever certificates in Africa.</h1>
      <p class="lede">{all.length} countries ask every traveller for the yellow card. {risk.length} ask only if you arrive from, or transit through, a country with yellow fever risk. {no.length} have no requirement.</p>
      <p class="page-meta"><span>Last checked {formatDate(DATA_CHECKED)}</span><span>Source: WHO country list</span></p>
    </section>
    <section class="section" style="border-top:0;padding-top:0">
      <h2 class="h2">Required for all travellers ({all.length})</h2>
      <ul class="chips">{all.map((c) => <li><a href={countryPath(c)}>{c.name}</a></li>)}</ul>
    </section>
    <section class="section">
      <h2 class="h2">Required if arriving from a risk country ({risk.length})</h2>
      <ul class="chips">{risk.map((c) => <li><a href={countryPath(c)}>{c.name}</a></li>)}</ul>
    </section>
    <section class="section">
      <h2 class="h2">Not required ({no.length})</h2>
      <ul class="chips">{no.map((c) => <li><a href={countryPath(c)}>{c.name}</a></li>)}</ul>
    </section>
    <Faq items={faq} />
    <section class="section" id="sources">
      <h2 class="h2">Sources</h2>
      <ul class="sources">
        <li><a href={globalSources[0].url} rel="noopener" target="_blank">{globalSources[0].label}</a></li>
        <li><a href="https://www.cdc.gov/yellow-book/hcp/travel-associated-infections-diseases/yellow-fever.html" rel="noopener" target="_blank">CDC Yellow Book: Yellow fever</a></li>
      </ul>
      <p style="color:var(--muted);font-size:14px;margin-top:12px">For Ghana, Guinea, South Sudan and Uganda we follow the stricter US State Department guidance (required for all travellers).</p>
    </section>
  </div>
</Base>
