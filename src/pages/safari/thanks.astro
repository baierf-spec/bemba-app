---
import Base from '../../layouts/Base.astro';
---
<Base title="Request sent" description="Your safari request has been sent to local operators." noindex>
  <div class="wrap narrow">
    <section class="page-head" style="padding-block:60px">
      <p class="eyebrow">Request sent</p>
      <h1 class="h1">Thanks. Operators will email you within 48 hours.</h1>
      <p class="lede">Check your spam folder if nothing arrives. Meanwhile, make sure your entry papers are in order.</p>
      <p style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href="/countries/">Check entry rules</a><a class="btn ghost" href="/">Back to home</a></p>
    </section>
  </div>
</Base>
